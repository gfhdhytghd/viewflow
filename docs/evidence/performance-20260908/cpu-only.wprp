<?xml version="1.0" encoding="utf-8"?>
<WindowsPerformanceRecorder Version="1.0" Author="Viewflow">
 <Profiles>
  <SystemCollector Id="ViewflowCPUCollector" Name="Viewflow CPU samples"><BufferSize Value="256"/><Buffers Value="128"/></SystemCollector>
  <SystemProvider Id="ViewflowCPUProvider"><Keywords><Keyword Value="ProcessThread"/><Keyword Value="Loader"/><Keyword Value="SampledProfile"/></Keywords><Stacks><Stack Value="SampledProfile"/></Stacks></SystemProvider>
  <Profile Id="ViewflowCPU.Verbose.File" Name="ViewflowCPU" Description="CPU samples only; no context switch, GPU, or DWM events" DetailLevel="Verbose" LoggingMode="File"><Collectors><SystemCollectorId Value="ViewflowCPUCollector"><SystemProviderId Value="ViewflowCPUProvider"/></SystemCollectorId></Collectors></Profile>
 </Profiles>
</WindowsPerformanceRecorder>
