#ifndef VFTRACKPADROOT_IIG
#define VFTRACKPADROOT_IIG
#include <DriverKit/IOService.iig>
class VFTrackpadRoot : public IOService {
public:
    virtual bool init() override;
    virtual void free() override;
    virtual kern_return_t Start(IOService *provider) override;
    virtual kern_return_t Stop(IOService *provider) override;
    virtual kern_return_t NewUserClient(uint32_t type, IOUserClient **userClient) override;
    virtual kern_return_t submit(IOUserClient *client, const uint8_t *bytes, uint32_t length) LOCALONLY;
    virtual kern_return_t releaseInput(IOUserClient *client) LOCALONLY;
    virtual void clientClosed(IOUserClient *client) LOCALONLY;
    virtual void status(uint64_t *values) LOCALONLY;
};
#endif
