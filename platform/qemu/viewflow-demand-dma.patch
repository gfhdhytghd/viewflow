     ram_flags |= fb->is_pmem ? RAM_PMEM : 0;
     ram_flags |= RAM_NAMED_FILE;
-    return memory_region_init_ram_from_file(&backend->mr, OBJECT(backend), name,
-                                            backend->size, fb->align, ram_flags,
-                                            fb->mem_path, fb->offset, errp);
+    if (!memory_region_init_ram_from_file(&backend->mr, OBJECT(backend), name,
+                                         backend->size, fb->align, ram_flags,
+                                         fb->mem_path, fb->offset, errp)) {
+        return false;
+    }
+    if (fb->viewflow_dma_managed) {
+        if (host_memory_backend_pagesize(backend) > VIEWFLOW_DMA_GRANULARITY) {
+            error_setg(errp, "managed DMA backing page size exceeds 1 MiB");
+            return false;
+        }
+        if (ram_block_coordinated_discard_require(true)) {
+            error_setg(errp, "coordinated RAM discard is unavailable");
+            return false;
+        }
+        fb->viewflow_dma_required = true;
+        if (memory_region_add_ram_discard_source(&backend->mr,
+                                                 RAM_DISCARD_SOURCE(fb))) {
+            viewflow_dma_detach(fb);
+            error_setg(errp, "cannot attach managed DMA discard source");
+            return false;
+        }
+        fb->viewflow_dma_attached = true;
+        /* QOM deletes child properties before the parent's finalizer. */
+        object_ref(OBJECT(&backend->mr));
+        fb->viewflow_dma_mr_ref = true;
+        error_setg(&fb->viewflow_dma_migration_blocker,
+                   "Viewflow managed DMA RAM has no prefix migration state; "
+                   "migration and save/restore are unsupported");
+        if (migrate_add_blocker(&fb->viewflow_dma_migration_blocker,
+                               errp) < 0) {
+            viewflow_dma_detach(fb);
+            return false;
+        }
+    }
+    return true;
 #endif
 }
 
