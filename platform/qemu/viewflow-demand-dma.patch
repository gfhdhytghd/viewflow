From: Viewflow experimental integration
Subject: [EXPERIMENTAL] hostmem-file: opt-in grow-only demand DMA prefix

Based on QEMU 11.1.1 backends/hostmem-file.c and the upstream
RamDiscardSource/RamDiscardManager interfaces. Original QEMU copyright
and GNU GPL version 2 or later terms remain applicable; additions are
provided under GPL-2.0-or-later. No VFIO ioctl implementation is copied.

For isolated experiments only. Requires distinct backend IDs viewflow_dma_*
and share=on,reserve=off,prealloc=off. Backing paths have no basename restriction.
Attach with x-viewflow-dma-managed=on; prefix begins at zero. Increase
x-viewflow-dma-prefix via QOM only before submitting DMA to new pages.
The normal VFIO RDM listener maps notified prefixes. No shrink, migration
protocol, producer handshake, or production configuration is provided.
A migration blocker explicitly rejects migration/save while this managed
backend exists because its prefix has no VMState representation.


---
--- a/backends/hostmem-file.c
+++ b/backends/hostmem-file.c
@@ -16,6 +16,8 @@
 #include "qemu/module.h"
 #include "qemu/madvise.h"
 #include "system/hostmem.h"
+#include "system/ram-discard-manager.h"
+#include "migration/blocker.h"
 #include "qom/object_interfaces.h"
 #include "qom/object.h"
 #include "qapi/visitor.h"
@@ -34,7 +36,128 @@
     bool is_pmem;
     bool readonly;
     OnOffAuto rom;
+
+    /* Viewflow experimental demand-DMA prefix; GPL-2.0-or-later. */
+    bool viewflow_dma_managed;
+    bool viewflow_dma_attached;
+    bool viewflow_dma_mr_ref;
+    bool viewflow_dma_required;
+    uint64_t viewflow_dma_prefix;
+    Error *viewflow_dma_migration_blocker;
 };
+
+/*
+ * A producer must request and await a prefix increase before DMA into it.
+ * This source controls VFIO mappings, not CPU access or allocation of pages.
+ * Deliberately experimental: no shrinking, migration, or preallocation.
+ */
+#define VIEWFLOW_DMA_GRANULARITY (1ULL << 20)
+
+static uint64_t viewflow_dma_granularity(const RamDiscardSource *rds,
+                                       const MemoryRegion *mr)
+{
+    const HostMemoryBackendFile *fb = MEMORY_BACKEND_FILE(rds);
+
+    g_assert(mr == &fb->parent_obj.mr);
+    return VIEWFLOW_DMA_GRANULARITY;
+}
+
+static bool viewflow_dma_populated(const RamDiscardSource *rds,
+                                   const MemoryRegionSection *section)
+{
+    const HostMemoryBackendFile *fb = MEMORY_BACKEND_FILE(rds);
+    uint64_t offset = section->offset_within_region;
+
+    g_assert(section->mr == &fb->parent_obj.mr);
+    return offset <= fb->viewflow_dma_prefix &&
+           int128_le(section->size,
+                     int128_make64(fb->viewflow_dma_prefix - offset));
+}
+
+static bool viewflow_dma_get_managed(Object *obj, Error **errp)
+{
+    return MEMORY_BACKEND_FILE(obj)->viewflow_dma_managed;
+}
+
+static void viewflow_dma_set_managed(Object *obj, bool value, Error **errp)
+{
+    HostMemoryBackendFile *fb = MEMORY_BACKEND_FILE(obj);
+
+    if (host_memory_backend_mr_inited(MEMORY_BACKEND(obj))) {
+        error_setg(errp,
+                   "x-viewflow-dma-managed cannot change after allocation");
+        return;
+    }
+    fb->viewflow_dma_managed = value;
+}
+
+static void viewflow_dma_get_prefix(Object *obj, Visitor *v, const char *name,
+                                    void *opaque, Error **errp)
+{
+    uint64_t prefix = MEMORY_BACKEND_FILE(obj)->viewflow_dma_prefix;
+
+    visit_type_uint64(v, name, &prefix, errp);
+}
+
+static void viewflow_dma_set_prefix(Object *obj, Visitor *v, const char *name,
+                                    void *opaque, Error **errp)
+{
+    HostMemoryBackendFile *fb = MEMORY_BACKEND_FILE(obj);
+    HostMemoryBackend *backend = MEMORY_BACKEND(obj);
+    uint64_t prefix;
+    int ret;
+
+    if (!visit_type_uint64(v, name, &prefix, errp)) {
+        return;
+    }
+    /* Runtime only: always attach the source initially empty. */
+    if (!fb->viewflow_dma_managed || !fb->viewflow_dma_attached) {
+        error_setg(errp,
+                   "x-viewflow-dma-prefix requires allocated managed RAM");
+        return;
+    }
+    if (prefix < fb->viewflow_dma_prefix || prefix > backend->size ||
+        !QEMU_IS_ALIGNED(prefix, VIEWFLOW_DMA_GRANULARITY)) {
+        error_setg(errp, "DMA prefix must grow, be 1 MiB aligned, and fit RAM");
+        return;
+    }
+    if (prefix == fb->viewflow_dma_prefix) {
+        return;
+    }
+    ret = ram_discard_manager_notify_populate(
+        memory_region_get_ram_discard_manager(&backend->mr),
+        RAM_DISCARD_SOURCE(fb), fb->viewflow_dma_prefix,
+        prefix - fb->viewflow_dma_prefix);
+    if (ret) {
+        /* RDM rolls back listeners; the advertised prefix remains unchanged. */
+        error_setg_errno(errp, -ret, "DMA prefix population rejected");
+        return;
+    }
+    fb->viewflow_dma_prefix = prefix;
+}
+
+static void viewflow_dma_detach(HostMemoryBackendFile *fb)
+{
+    if (fb->viewflow_dma_attached) {
+        RamDiscardManager *rdm =
+            memory_region_get_ram_discard_manager(&fb->parent_obj.mr);
+        int ret;
+
+        /* Removing a source while listeners exist would populate the tail. */
+        if (!QLIST_EMPTY(&rdm->rdl_list)) {
+            return;
+        }
+        ret = memory_region_del_ram_discard_source(
+            &fb->parent_obj.mr, RAM_DISCARD_SOURCE(fb));
+
+        g_assert(ret == 0);
+        fb->viewflow_dma_attached = false;
+    }
+    if (fb->viewflow_dma_required) {
+        ram_block_coordinated_discard_require(false);
+        fb->viewflow_dma_required = false;
+    }
+}
 
